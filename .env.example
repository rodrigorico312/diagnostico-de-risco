# Variaveis usadas pela API de leads.
# Configure na Vercel, sem colocar valores reais no codigo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Dashboard de setores.
# Opção 1: Apps Script publicado como Web App que retorna JSON do dashboard.
DASHBOARD_SHEETS_WEBAPP_URL=
DASHBOARD_SHEETS_WEBAPP_SECRET=

# Opção 2: Google Cloud service account com acesso de leitura à planilha.
DASHBOARD_SPREADSHEET_ID=12lHzel9dKHF6rxpYT_m4OiEEu8PbtJNue_WD4vCpBUs
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Configure o WhatsApp diretamente em src/App.tsx:
# WHATSAPP_NUMBER="5593992101980"

# Portal do cliente (somente servidor; nunca usar prefixo VITE_ para estas variáveis).
# Manter false até configurar banco, e-mail e testar com duas empresas fictícias.
PORTAL_ENABLED=false
PORTAL_ORIGIN=https://www.nacionalcon.com
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
